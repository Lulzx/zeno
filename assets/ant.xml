<mujoco model="ant">
    <option timestep="0.005" gravity="0 0 -9.81"/>

    <default>
        <joint armature="0.01" damping="2.0" limited="true"/>
        <geom contype="2" conaffinity="1" condim="3" friction="1.2 0.2 0.1" density="300" margin="0.005"/>
    </default>

    <worldbody>
        <!-- Ground plane -->
        <geom type="plane" size="40 40 0.1" rgba="0.84 0.89 0.8 1" contype="1" conaffinity="2"/>

        <!-- Torso -->
        <body name="torso" pos="0 0 0.48">
            <joint name="root" type="free"/>
            <geom name="torso_geom" type="sphere" size="0.18" mass="2.0" rgba="0.8 0.58 0.38 1"/>

            <!-- Front Right Leg -->
            <body name="front_right_leg" pos="0.16 0.16 0">
                <joint name="hip_1" type="hinge" axis="0 0 1"/>
                <geom type="capsule" fromto="0 0 0 0.2 0.2 0" size="0.045" mass="0.35" rgba="0.84 0.62 0.44 1"/>

                <body name="front_right_foot" pos="0.2 0.2 0">
                    <joint name="ankle_1" type="hinge" axis="-1 1 0"/>
                    <geom type="capsule" fromto="0 0 0 0.18 0.18 -0.26" size="0.038" mass="0.25" rgba="0.84 0.62 0.44 1"/>
                </body>
            </body>

            <!-- Front Left Leg -->
            <body name="front_left_leg" pos="-0.16 0.16 0">
                <joint name="hip_2" type="hinge" axis="0 0 1"/>
                <geom type="capsule" fromto="0 0 0 -0.2 0.2 0" size="0.045" mass="0.35" rgba="0.84 0.62 0.44 1"/>

                <body name="front_left_foot" pos="-0.2 0.2 0">
                    <joint name="ankle_2" type="hinge" axis="1 1 0"/>
                    <geom type="capsule" fromto="0 0 0 -0.18 0.18 -0.26" size="0.038" mass="0.25" rgba="0.84 0.62 0.44 1"/>
                </body>
            </body>

            <!-- Back Right Leg -->
            <body name="back_right_leg" pos="0.16 -0.16 0">
                <joint name="hip_3" type="hinge" axis="0 0 1"/>
                <geom type="capsule" fromto="0 0 0 0.2 -0.2 0" size="0.045" mass="0.35" rgba="0.84 0.62 0.44 1"/>

                <body name="back_right_foot" pos="0.2 -0.2 0">
                    <joint name="ankle_3" type="hinge" axis="-1 -1 0"/>
                    <geom type="capsule" fromto="0 0 0 0.18 -0.18 -0.26" size="0.038" mass="0.25" rgba="0.84 0.62 0.44 1"/>
                </body>
            </body>

            <!-- Back Left Leg -->
            <body name="back_left_leg" pos="-0.16 -0.16 0">
                <joint name="hip_4" type="hinge" axis="0 0 1"/>
                <geom type="capsule" fromto="0 0 0 -0.2 -0.2 0" size="0.045" mass="0.35" rgba="0.84 0.62 0.44 1"/>

                <body name="back_left_foot" pos="-0.2 -0.2 0">
                    <joint name="ankle_4" type="hinge" axis="1 -1 0"/>
                    <geom type="capsule" fromto="0 0 0 -0.18 -0.18 -0.26" size="0.038" mass="0.25" rgba="0.84 0.62 0.44 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor joint="hip_1" ctrlrange="-1 1" gear="70"/>
        <motor joint="ankle_1" ctrlrange="-1 1" gear="60"/>
        <motor joint="hip_2" ctrlrange="-1 1" gear="70"/>
        <motor joint="ankle_2" ctrlrange="-1 1" gear="60"/>
        <motor joint="hip_3" ctrlrange="-1 1" gear="70"/>
        <motor joint="ankle_3" ctrlrange="-1 1" gear="60"/>
        <motor joint="hip_4" ctrlrange="-1 1" gear="70"/>
        <motor joint="ankle_4" ctrlrange="-1 1" gear="60"/>
    </actuator>

    <sensor>
        <!-- Torso sensors -->
        <framepos objtype="body" objname="torso"/>
        <framequat objtype="body" objname="torso"/>
        <framelinvel objtype="body" objname="torso"/>
        <frameangvel objtype="body" objname="torso"/>

        <!-- Joint sensors -->
        <jointpos joint="hip_1"/>
        <jointpos joint="ankle_1"/>
        <jointpos joint="hip_2"/>
        <jointpos joint="ankle_2"/>
        <jointpos joint="hip_3"/>
        <jointpos joint="ankle_3"/>
        <jointpos joint="hip_4"/>
        <jointpos joint="ankle_4"/>

        <jointvel joint="hip_1"/>
        <jointvel joint="ankle_1"/>
        <jointvel joint="hip_2"/>
        <jointvel joint="ankle_2"/>
        <jointvel joint="hip_3"/>
        <jointvel joint="ankle_3"/>
        <jointvel joint="hip_4"/>
        <jointvel joint="ankle_4"/>
    </sensor>
</mujoco>
